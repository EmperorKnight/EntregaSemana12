<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.administracionfx.Controllers.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Busqueda: " />
        <TextField fx:id="txtParametro" HBox.hgrow="ALWAYS" />
        <Button onAction="#buscar" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold;" text="BUSCAR" />
    </HBox>

    <TableView fx:id="Usuarios" prefHeight="600" prefWidth="1000">
        <columns>
            <TableColumn fx:id="colID" prefWidth="100" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="100" text="Primer Nombre" />
            <TableColumn fx:id="colSNombre" prefWidth="100" text="Segundo Nombre"/>
            <TableColumn fx:id="colApellido" prefWidth="100" text="Primer Apellido" />
            <TableColumn fx:id="colSApellido" prefWidth="100" text="Segundo Apellido"/>
            <TableColumn fx:id="colCorreo" prefWidth="100" text="Correo" />
            <TableColumn fx:id="colUsuario" prefWidth="100" text="Usuario" />
            <TableColumn fx:id="colPassword" prefWidth="100" text="Contraseña" />
            <TableColumn fx:id="colRutaFoto" prefWidth="100" text="Ruta Foto" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" prefHeight="0.0" prefWidth="800.0" spacing="10">
        <Button onAction="#registrar" style="-fx-background-color: purple; -fx-text-fill: white; -fx-font-weight: bold;" text="NUEVO USUAIO" />
        <Button onAction="#editar" style="-fx-background-color: blue; -fx-text-fill: white; -fx-font-weight: bold;" text="EDITAR" />
        <Button onAction="#eliminar" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-weight: bold;" text="ELIMINAR" />
    </HBox>
</VBox>
