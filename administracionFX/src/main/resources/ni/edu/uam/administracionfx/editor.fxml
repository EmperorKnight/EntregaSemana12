<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.administracionfx.Controllers.EditorController"
            prefHeight="500.0" prefWidth="400.0">
    <VBox alignment="CENTER" spacing="10" AnchorPane.bottomAnchor="15" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="15">

        <Label style="-fx-font-size:24px;-fx-font-width: bold;" text="EDITAR USUARIO" />

        <GridPane hgap="10" prefHeight="200.0" prefWidth="500.0" vgap="10" alignment="CENTER">
            <Label text="Primer Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtPNombre" GridPane.columnIndex="0" GridPane.rowIndex="1" />

            <Label text="Segundo Nombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="txtSNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Primer Apellido" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtPApellido" GridPane.columnIndex="0" GridPane.rowIndex="3" />

            <Label text="Segundo Apellido" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtSApellido" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Correo" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtCorreo" GridPane.columnSpan="2" GridPane.columnIndex="0" GridPane.rowIndex="5" />

            <Label text="Usuario" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <TextField fx:id="txtUsuario" GridPane.columnSpan="2" GridPane.columnIndex="0" GridPane.rowIndex="7" />

            <Label text="Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="8" />
            <PasswordField fx:id="txtPassword" GridPane.columnSpan="2" GridPane.columnIndex="0" GridPane.rowIndex="9" />

            <Label text="Confirmar Contraseña" GridPane.columnIndex="0" GridPane.rowIndex="10" />
            <PasswordField fx:id="txtConfirmaPassword" GridPane.columnSpan="2" GridPane.columnIndex="0" GridPane.rowIndex="11" />
        </GridPane>

        <HBox alignment="CENTER" spacing="10">
            <Button maxWidth="Infinity" onAction="#seleccionarFoto" text="SELECCIONAR FOTO"/>
            <ImageView fx:id="imageFoto" fitHeight="120" fitWidth="120" preserveRatio="true"/>
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#actualizar" prefWidth="150" text="ACTUALIZAR" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button onAction="#regresar" prefWidth="150" text="REGRESAR" style="-fx-background-color: yellow; -fx-text-fill: black; -fx-font-weight: bold"/>
        </HBox>

    </VBox>

</AnchorPane>
